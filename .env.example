# Copy to .env and fill in. Never commit .env.
# Only VITE_-prefixed vars are exposed to the client bundle.

# --- Supabase (client-safe: anon key is public by design, protected by RLS) ---
# Leaving the anon key blank falls back to the Supabase CLI's well-known local
# dev key, so `npm run dev` works against `supabase start` with no edits here.
# Set a real key for staging/production.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# --- Observability (gated behind flags; leave blank to disable locally) ---
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- Feature/telemetry flags ---
VITE_ENABLE_SENTRY=false
VITE_ENABLE_POSTHOG=false

# --- Web Push reminders ---
# The PUBLIC half of the VAPID key pair (base64url) — client-safe by design; the
# browser hands it to the push service when subscribing. Leave blank and the
# reminders card stays switched off instead of erroring.
VITE_VAPID_PUBLIC_KEY=

# =====================================================================
# SERVER-ONLY — these must NEVER be prefixed with VITE_ and never reach
# the client. Set in Supabase Edge Function env, not in this web app.
#   ANTHROPIC_API_KEY=...
#   SUPABASE_SERVICE_ROLE_KEY=...
#   VAPID_PRIVATE_KEY=...   (private half of the pair above)
#   VAPID_PUBLIC_KEY=...    VAPID_SUBJECT=mailto:you@example.com
#   CRON_SECRET=...         (also a GitHub repo secret; guards send-reminders)
# =====================================================================
